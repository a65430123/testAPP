# 複製成 server/.env 後依環境修改。伺服器啟動時會自動讀取 server/.env。

# 伺服器連接埠
PORT=2567

# PostgreSQL 連線字串（預設值對應 docker-compose.dev.yml）
DATABASE_URL=postgres://starmemory:starmemory@localhost:5432/starmemory

# JWT 簽章金鑰：正式環境務必改成夠長的隨機字串（例如 openssl rand -base64 48）
JWT_SECRET=請改成隨機字串
# JWT 有效期限
JWT_EXPIRES_IN=7d

# bcrypt 成本參數（越大越安全也越慢，建議 10 以上）
BCRYPT_ROUNDS=12

# 允許呼叫 API 的網頁來源；正式環境請設成遊戲網址，例如 https://game.example.com
CORS_ORIGIN=*

# 啟動時自動執行尚未套用的 migration
AUTO_MIGRATE=true

# 是否開啟 GM 聊天指令（/gm level、/gm item）。只在開發與測試時開啟！
ENABLE_GM_COMMANDS=false

# 伺服器前面有反向代理（Nginx）時設為 true，才能取得玩家的真實 IP 做登入頻率限制
TRUST_PROXY=false
