{
  "name": "@starmemory/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "migrate": "tsx src/db/migrate.ts",
    "smoke": "tsx scripts/smoke.ts && tsx scripts/smoke-combat.ts && tsx scripts/smoke-items.ts && tsx scripts/smoke-social.ts",
    "typecheck": "tsc -p tsconfig.json",
    "check:content": "tsx scripts/check-content.ts"
  },
  "dependencies": {
    "@colyseus/schema": "^5.0.46",
    "@starmemory/shared": "*",
    "bcrypt": "^6.0.0",
    "colyseus": "^0.18.12",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.10",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0"
  }
}
