{
  "name": "starmemory",
  "private": true,
  "version": "0.1.0",
  "description": "《星憶旅團》2D 網頁多人線上 RPG（monorepo）",
  "type": "module",
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev -w @starmemory/client",
    "dev:server": "npm run dev -w @starmemory/server",
    "build": "npm run build -w @starmemory/client",
    "preview": "npm run preview -w @starmemory/client",
    "server": "npm run start -w @starmemory/server",
    "smoke": "npm run smoke -w @starmemory/server",
    "test": "npm run test -w @starmemory/shared",
    "typecheck": "npm run typecheck --workspaces",
    "gen:assets": "node tools/gen-placeholders.mjs",
    "migrate": "npm run migrate -w @starmemory/server",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "check:content": "npm run check:content -w @starmemory/server"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
